{
  "name": "module-router",
  "version": "1.0.0",
  "description": "",
  "license": "MIT",
  "author": "xvzhenduo",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "lint:check": "eslint . --cache --cache-location ./node_modules/.cache/eslint/",
    "lint:fix": "eslint . --fix --cache --cache-location ./node_modules/.cache/eslint/",
    "format:check": "prettier --check --cache .",
    "format:fix": "prettier --write --cache .",
    "typecheck": "tsc",
    "checkall": "npm run lint:check && npm run typecheck && npm run format:check",
    "fixall": "npm run typecheck && npm run lint:fix && npm run format:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --cache --cache-location ./node_modules/.cache/eslint/",
      "prettier --check --cache"
    ],
    "*.{json,md,yml,yaml,html,css}": [
      "prettier --check --cache"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  }
}
